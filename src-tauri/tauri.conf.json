{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music AI Player",
  "version": "0.1.0",
  "identifier": "io.github.pl0xuee.musicaiplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Music AI Player",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#08090A"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Player for a locally generated dark techno library",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
